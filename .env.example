# ─── ClickUp credentials ───────────────────────────────────────────
# Personal API Token — https://app.clickup.com/settings/apps → "Generate"
# Paste the raw token. Do NOT add a "Bearer " prefix; ClickUp v2 does not use one.
CLICKUP_API_TOKEN=pk_your_token_here

# Workspace (Team) ID — the number in any ClickUp URL:
#   https://app.clickup.com/9013992885/home
#                          ^^^^^^^^^^
CLICKUP_WORKSPACE_ID=9013992885

# Sprint FOLDER ID — must be a Folder, not a Space and not a List.
# Open the Sprint Folder in ClickUp; the ID is the long number in the URL.
# Getting the object type wrong here is the usual cause of an empty dashboard —
# run `npm run diagnose` and it will tell you which one you have.
CLICKUP_SPRINT_FOLDER_ID=90137660410

# ─── Server ────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# Seconds to cache sprint data server-side. ClickUp allows 100 req/min per
# token, so don't drop this too low on a busy dashboard.
CACHE_TTL_SECONDS=300
