# ─── Sprint Intelligence — environment template ─────────────────────
# Copy to .env at the repo root:  cp .env.example .env
# .env is gitignored — never commit a real token.

# ─── Demo mode ──────────────────────────────────────────────────────
# Run the dashboard against bundled sample data, with no ClickUp account
# and no credentials. Everything below is ignored when this is true.
DEMO_MODE=false

# ─── ClickUp (required unless DEMO_MODE=true) ───────────────────────
# Personal API token: https://app.clickup.com/settings/apps → "Generate"
CLICKUP_API_TOKEN=pk_your_token_here

# Workspace ID — the number in any ClickUp URL:
#   https://app.clickup.com/{WORKSPACE_ID}/home
CLICKUP_WORKSPACE_ID=9013992885

# Folder holding your sprint lists. Open the Sprint Board folder in
# ClickUp and take the ID from the URL. Required for GET /api/sprints.
CLICKUP_SPRINT_FOLDER_ID=90137660410

# ─── Server ─────────────────────────────────────────────────────────
# Port for the Express API (the Vite dev proxy expects 3001).
PORT=3001

# "production" serves the built client from client/dist and disables
# request logging, stack traces in errors, and cross-origin requests.
NODE_ENV=development

# Server-side cache lifetime for ClickUp responses, in seconds.
CACHE_TTL_SECONDS=300
